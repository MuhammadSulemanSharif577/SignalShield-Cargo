APP_NAME='SignalShield Cargo API'
DATABASE_URL=postgresql+psycopg://postgres:DB_PASSWORD@localhost:5432/signalshield_db

JWT_SECRET_KEY=SECRET_KEY_HERE
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

REMEMBER_ME_EXPIRE_DAYS=7

API_PREFIX=/api/v1
CORS_ORIGINS=["http://localhost:3000"]
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCK_MINUTES=15
